# avatartrace configuration. Copy this file to ".env" and fill in only what you have.
# Every line is optional: with no keys at all the tool prints reverse-search links
# and verifies the profile URLs you pass with --candidate.
#
# Never commit your real .env file. It is listed in .gitignore.

# ---------------------------------------------------------------------------
# Search providers (step 1, discovery). Setting a key enables that provider.
# You are asked to confirm before a photo is sent to any of them.
# ---------------------------------------------------------------------------

# Google Cloud Vision, Web Detection. Receives the photo.
# https://console.cloud.google.com/apis/credentials (enable the "Cloud Vision API")
GOOGLE_VISION_API_KEY=

# SerpApi: Google Lens, Google Reverse Image, Yandex Images, Bing Reverse Image.
# Receives the photo's public URL only, so it needs a URL input or --image-url.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Use only some engines (each request is one billed search; Google Lens makes two):
# AVATARTRACE_SERPAPI_ENGINES=["google_lens","google_reverse_image","yandex_images","bing_reverse_image"]

# TinEye commercial API. Receives the photo.
# https://services.tineye.com/TinEyeAPI
TINEYE_API_KEY=

# FaceCheck.ID face search. Receives the photo. Matches the face, not the picture:
# read the "Ethics & safety" section of the README before enabling it.
# https://facecheck.id/Face-Search/API
FACECHECK_API_TOKEN=
# Demo mode searches only the first 100,000 faces and costs no credits (integration testing only):
# AVATARTRACE_FACECHECK_DEMO=true
# AVATARTRACE_FACECHECK_MIN_SCORE=70

# SauceNAO, for artwork / anime / illustration avatars. Receives the photo.
# https://saucenao.com/user.php?page=search-api
SAUCENAO_API_KEY=

# ---------------------------------------------------------------------------
# Official profile APIs (step 3, verification). All optional.
# These are application keys, never a user login.
# ---------------------------------------------------------------------------

# Raises the GitHub API limit from 60 to 5,000 requests an hour. No scopes needed.
GITHUB_TOKEN=

# YouTube Data API v3 key (otherwise the public channel page is used).
YOUTUBE_API_KEY=

# Twitch application credentials (otherwise the public channel page is used).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# X API v2 bearer token (otherwise the public profile HTML is used).
X_BEARER_TOKEN=

# Reddit "script" app credentials. Without them Reddit accounts are UNVERIFIED.
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Behaviour. The values shown are the defaults.
# ---------------------------------------------------------------------------

# Minimum seconds between two requests to the same site, and requests in flight at once.
# AVATARTRACE_PER_HOST_INTERVAL=1.0
# AVATARTRACE_MAX_CONCURRENCY=8
# AVATARTRACE_REQUEST_TIMEOUT=20

# Upper bounds for one scan.
# AVATARTRACE_MAX_CANDIDATES=150
# AVATARTRACE_MAX_EXPANSION_SEEDS=5

# Attribute posts that name their author (x.com/<user>/status/...) to that author.
# AVATARTRACE_INCLUDE_CONTENT_URLS=true

# Match thresholds. See docs/thresholds.md before changing them.
# AVATARTRACE_THRESHOLDS__HASH_NEAR_MAX=8
# AVATARTRACE_THRESHOLDS__HASH_WEAK_MAX=12
# AVATARTRACE_THRESHOLDS__FACE_SAME_MIN=0.45
# AVATARTRACE_THRESHOLDS__FACE_WEAK_MIN=0.32
# AVATARTRACE_THRESHOLDS__CLIP_NEAR_MIN=0.95
# AVATARTRACE_THRESHOLDS__CLIP_WEAK_MIN=0.90

# Models and the --keep-cache location.
# AVATARTRACE_FACE_MODEL=buffalo_l
# AVATARTRACE_CACHE_DIR=~/.cache/avatartrace
